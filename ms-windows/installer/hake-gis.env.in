# Paths for the installed app. {app} is expanded by hake-geodesk.exe to the bin/
# directory containing the executable. Keep PATH short — do not paste the
# machine system PATH here (that causes Windows environment-block overflow).
#
# PROJ_LIB is set to the same directory as PROJ_DATA so a machine-global
# PROJ_LIB (e.g. from PostGIS/PostgreSQL) cannot point GDAL child processes at
# an incompatible older proj.db. See GitHub issue #10.
PATH={app}
QGIS_PREFIX_PATH={prefix}
PROJ_DATA={prefix}\share\proj
PROJ_LIB={prefix}\share\proj
GDAL_DATA={prefix}\share\gdal
QT_PLUGIN_PATH={app}\Qt6\plugins;{app}\Qt6\plugins\crypto
PYTHONHOME={app}
PYTHONPATH={prefix}\python;{app}\Lib;{app}\Lib\site-packages;{app}\DLLs
