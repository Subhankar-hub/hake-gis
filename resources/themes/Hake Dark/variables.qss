@background: #050d28
@itembackground: #0a1945
@itemalternativebackground: #1a3a7a
@itemdarkbackground: #122456
@darkgradient: QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #1a2d5c, stop: 0.1 #162650, stop: 0.5 #122048, stop: 0.9 #0e1a3e, stop: 1 #0c1738)
@darkalternativegradient: QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #1e3a72, stop: 1 #122456);
@gradient: QLinearGradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2b5cb8, stop:1 #1a3a7a)
@textlight: #e8eef8
@text: #c5d0e6
@toggleoff: #122456
@toggleon: #2563eb
@selection: #1e4d9c
@hover: #122456
@focusdark: rgba(59,130,246,100)
@focus: #3b82f6
