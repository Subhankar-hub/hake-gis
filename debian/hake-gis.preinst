#!/bin/sh

set -e

if [ "$1" = "install" -o "$1" = "upgrade" ]; then
	# Remove obsolete diversions
	for i in /usr/bin/hake-gis /usr/bin/qbrowser; do
		pkg=$(dpkg-divert --listpackage $i)
		if [ -n "$pkg" -a "$pkg" = hake-gis-plugin-grass -o "$pkg" = hake-gis-provider-grass ]; then
			dpkg-divert --package $pkg --remove $i
		fi
	done
fi

#DEBHELPER#

exit 0
